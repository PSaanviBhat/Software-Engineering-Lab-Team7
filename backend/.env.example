PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tutoring
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me
FRONTEND_URL=http://localhost:3000

# Email (use your Mailtrap sandbox values in your own .env, never here)
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Peer Tutoring <no-reply@tutoring.local>"
MAIL_TIMEZONE=Asia/Kolkata

# Run the email worker inside the API process (set to false to turn it off)
RUN_WORKER=true

EMAIL_MAX_ATTEMPTS=4
EMAIL_BACKOFF_MS=2000